# Upstream AI / opencode server URL — set in Netlify dashboard (Site settings → Environment variables)
# Used by src/routes/api/chat/+server.ts and src/routes/api/health/+server.ts
# Example: OPENCODE_API_URL=https://your-opencode-server.example.com
OPENCODE_API_URL=
# Alternative name (also supported):
# AI_API_URL=

# For local dev, create .env with the same key:
# echo 'OPENCODE_API_URL=http://localhost:4096' > .env
